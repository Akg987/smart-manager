{
  "name": "@smartmanager/api",
  "private": true,
  "version": "0.1.0",
  "description": "Smart Manager NestJS Fastify API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "start:tsx": "tsx --tsconfig tsconfig.json src/main.ts",
    "start:watch": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir ../.. && node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir ../.. && node --test dist/apps/api/src/modules/kpi-management/kpi-management.service.spec.js dist/apps/api/src/modules/shared-business-rules.spec.js dist/apps/api/src/modules/authorization/authorization.spec.js dist/apps/api/src/modules/auth/auth.integration.spec.js",
    "lint": "pnpm dlx ultracite check",
    "format": "pnpm dlx ultracite fix"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.2.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
