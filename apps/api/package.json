{
  "name": "@smartmanager/api",
  "private": true,
  "version": "0.1.0",
  "description": "Smart Manager NestJS Fastify API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/apps/api/src/main.js",
    "start:tsx": "tsx --tsconfig tsconfig.json src/main.ts",
    "start:watch": "tsc -p tsconfig.build.json && node --enable-source-maps dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit false --rootDir ../.. --outDir dist && node --test dist/apps/api/src/common/auth-context.store.spec.js dist/apps/api/src/module/corrective-actions/action-workflow.spec.js dist/apps/api/src/module/decisions/decision-workflow.spec.js dist/apps/api/src/module/kpi-management/kpi-management.service.spec.js dist/apps/api/src/module/kpi-management/kpi-workflow.spec.js dist/apps/api/src/module/kpi-management/kpi-calculation.spec.js dist/apps/api/src/module/kpi-management/red-flag-engine.spec.js dist/apps/api/src/module/kpi-management/formula-engine.spec.js dist/apps/api/src/module/management-workflows/escalation-engine.spec.js dist/apps/api/src/module/shared-business-rules.spec.js dist/apps/api/src/module/authorization/authorization.spec.js dist/apps/api/src/module/authorization/tenant-authorization.spec.js dist/apps/api/src/module/auth/runtime/auth.integration.spec.js dist/apps/api/src/module/auth/runtime/auth-permissions.spec.js dist/apps/api/src/module/auth/runtime/smart-manager-jwt.spec.js dist/apps/api/src/module/tenant-admin/invitation-security.spec.js",
    "lint": "pnpm dlx ultracite check",
    "format": "pnpm dlx ultracite fix"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.2.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
