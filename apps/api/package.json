{
	"name": "@smartmanager/api",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"start": "tsx --tsconfig tsconfig.json src/main.ts",
		"start:watch": "tsx watch --tsconfig tsconfig.json src/main.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir ../.. && node --test dist/apps/api/src/modules/kpi-management/kpi-management.service.spec.js dist/apps/api/src/modules/shared-business-rules.spec.js dist/apps/api/src/modules/authorization/authorization.spec.js dist/apps/api/src/modules/auth/auth.integration.spec.js"
	},
	"dependencies": {
		"@nestjs/common": "^11.2.7",
		"@nestjs/core": "^11.2.7",
		"@nestjs/platform-express": "^11.2.7",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/testing": "^11.2.7",
		"@types/express": "^5.0.6"
	}
}
